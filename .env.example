# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# Optional: Anthropic API key (for future AI-based bill analysis features)
ANTHROPIC_API_KEY=

# Flask settings
FLASK_ENV=development
FLASK_PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Groq (fast, cloud LLM for letter_generator.py — primary; free at console.groq.com)
GROQ_API_KEY=   # Free at console.groq.com — used for fast letter generation

# Ollama (local LLM for letter_generator.py — offline fallback if Groq unavailable)
OLLAMA_URL=http://localhost:11434   # Offline fallback if Groq unavailable
OLLAMA_MODEL=llama3.2

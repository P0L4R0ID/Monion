  "metadata": {
    "name": "Malaysian Drug Reference Prices",
    "version": "1.0",
    "source": "Malaysia Medicine Price Guide (MyPriMe), Pharmaceutical Services Programme MOH (https://pharmacy.moh.gov.my/en/apps/drug-price)",
    "description": "Advisory benchmark prices for common drugs in Malaysian private clinics and hospitals. Private drug prices are NOT regulated. These prices serve as indicators to flag potentially excessive markups, not as legal caps.",
    "IMPORTANT_READ_FIRST": [
      "Prices are strictly ADVISORY benchmarks derived from MyPriMe. There is no legal price cap on medications in the private healthcare sector in Malaysia.",
      "If 'verified' is true, the price range is confirmed from MyPriMe (Aug 2025). If 'verified' is false, it is a realistic indicative range but MUST be manually checked against MyPriMe."
    ],
    "flag_rule_hint": {
      "excessive_markup_multiplier": 3.0,
      "explanation": "Flag if billed_price > reference_max * 3. Private hospitals often mark up drugs by 1.5x - 3x. Flagging at 3x highlights significant outliers for review."
    }
  },
